<%- include("../partials/top", { title: "Categorias", active: "categorias" }) %>

<section class="secao painel-admin">
  <div class="painel-form">
    <h1>Nova categoria</h1>
    <% if (typeof erro !== "undefined" && erro) { %><p class="form-erro"><%= erro %></p><% } %>
    <form class="formulario" method="POST" action="/categorias">
      <label>Nome*
        <input type="text" name="nome" required>
      </label>
      <label>Descrição
        <textarea name="descricao" rows="3"></textarea>
      </label>
      <button type="submit" class="botao botao-primario">Cadastrar</button>
    </form>
  </div>
  <div class="painel-tabela">
    <h2>Categorias cadastradas <span class="contador"><%= categorias.length %></span></h2>
    <div class="tabela-wrap">
      <table class="tabela">
        <thead><tr>
          <th>Nome</th>
          <th>Descrição</th>
          <th class="numerico">Produtos</th>
          <th>Ações</th>
        </tr>
        </thead>
        <tbody>
          <% if (categorias.length === 0) { %>
            <tr><td colspan="4" class="vazio">Nenhuma categoria cadastrada.</td></tr>
          <% } %>
          <% categorias.forEach(function (c) { %>
            <% var total = produtos.filter(function (p) { return p.categoriaId === c.id; }).length; %>
            <tr>
              <td data-rotulo="Categoria"><%= c.nome %></td>
              <td data-rotulo="Descricao"><%= c.descricao %></td>
              <td data-rotulo="Produtos" class="numerico"><%= total %></td>
              <td data-rotulo="Acoes" class="tabela-acoes">
                <a class="botao botao-pequeno botao-outline" href="/categorias/<%= c.id %>/editar">Editar</a>
                <form method="POST" action="/categorias/<%= c.id %>?_method=DELETE" data-confirmar="Remover a categoria <%= c.nome %>?">
                  <input type="hidden" name="_method" value="DELETE">
                  <button class="botao botao-pequeno botao-perigo" type="submit">Excluir</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</section>

<%- include("../partials/bottom") %>
