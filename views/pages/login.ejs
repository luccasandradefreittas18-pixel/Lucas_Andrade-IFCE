<%- include("../partials/top", { title: "Login", active: "login" }) %>

<section class="secao secao-login">
  <form class="cartao-login" method="POST" action="/login<%= proximo ? "?proximo=" + encodeURIComponent(proximo) : "" %>">
    <h1>Faca login ou cadastre-se</h1>
    <% if (typeof erro !== "undefined" && erro) { %><p class="form-erro"><%= erro %></p><% } %>
    <label>E-mail
      <input type="email" name="email" placeholder="Usuario" required value="<%= typeof email !== "undefined" ? email : "" %>">
    </label>
    <label>Senha
      <input type="password" name="senha" id="senha-login" required>
    </label>
    <div class="linha-login">
      <label class="checkbox">
        <input type="checkbox" id="mostrar-senha" data-alvo="senha-login">
        Mostrar senha
      </label>
      <a href="/recuperar-senha">Esqueci minha senha</a>
    </div>
    <button type="submit" class="botao botao-primario">Entrar</button>
    <p class="apoio">Ainda nao tem uma conta? <a href="/usuarios/novo">Cadastre-se</a></p>
  </form>
</section>

<%- include("../partials/bottom") %>
